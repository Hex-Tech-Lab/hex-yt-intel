{
  "name": "hex-yt-intel",
  "version": "1.6.0",
  "private": true,
  "description": "YouTube Content Intelligence Platform",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "type-check": "pnpm -r type-check",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "format": "pnpm -r format",
    "setup:cron": "tsx scripts/setup-qstash-cron.ts"
  },
  "devDependencies": {
    "@upstash/qstash": "2.11.0",
    "pnpm": "11.1.3",
    "supabase": "2.100.1",
    "tailwindcss": "^4.3.0",
    "tsx": "4.22.4"
  },
  "engines": {
    "node": "24.16.0",
    "pnpm": "11.1.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.1.3",
      "onFail": "ignore"
    }
  }
}
