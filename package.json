{
  "name": "hex-yt-intel",
  "version": "1.0.0",
  "description": "YouTube Content Intelligence System - Complete Knowledge Management Platform",
  "private": true,
  "workspaces": [
    "worker",
    "skill",
    "web",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "db:push": "cd web && npx supabase db push",
    "db:seed": "cd web && npx supabase db seed",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/stripe/webhook"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.6.2"
  },
  "packageManager": "pnpm@9.1.0",
  "dependencies": {
    "lucide-react": "1.14.0"
  }
}
