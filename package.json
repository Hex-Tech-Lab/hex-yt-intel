{
  "name": "hex-yt-intel",
  "version": "1.0.0",
  "description": "YouTube Content Intelligence System - Complete Knowledge Management Platform",
  "private": true,
  "workspaces": [
    "worker",
    "skill",
    "web",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "db:push": "cd web && npx supabase db push",
    "db:seed": "cd web && npx supabase db seed",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/stripe/webhook",
    "verify:production": "./scripts/verify-production.sh https://hex-yt-intel.vercel.app",
    "verify:staging": "./scripts/verify-production.sh https://staging.hex-yt-intel.vercel.app",
    "deploy:prod": "vercel deploy --prod",
    "deploy:staging": "vercel deploy --scope=hex-tech-lab",
    "env:validate": "pnpm tsx web/lib/env.ts"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.6.2"
  },
  "packageManager": "npm@11",
  "dependencies": {
    "lucide-react": "1.14.0"
  }
}
