# TestSprite E2E test credentials (real Supabase Auth test account)
#
# These scripts FAIL LOUDLY at import if either variable is unset.
# Export real values in your shell before running (these scripts read
# os.environ directly -- there is no dotenv loader, so a .env.local file is
# NOT picked up automatically):
#   export TESTSPRITE_TEST_ACCOUNT_EMAIL=...
#   export TESTSPRITE_TEST_ACCOUNT_PASSWORD=...
# NEVER commit real values -- the test account lives on the production
# Supabase project.
#
# The password was rotated 2026-09-10 after a plaintext credential leak was
# found in the git-tracked TC*.py scripts (see .memory/AGENT_LEDGER.md,
# SINK: testsprite-credential-leak-remediation).
TESTSPRITE_TEST_ACCOUNT_EMAIL=
TESTSPRITE_TEST_ACCOUNT_PASSWORD=
