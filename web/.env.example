# Authentication Provider (Modular)
# Options: 'supabase' (default, built-in Google OAuth) | 'nextauth' (requires GCP OAuth)
AUTH_PROVIDER=supabase

# Supabase (Primary Provider - no GCP credentials needed)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# NextAuth Configuration (Optional, alternative provider)
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# OAuth Providers (Google) - only if using NextAuth
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# Stripe
STRIPE_SECRET_KEY=sk_test_your-test-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-test-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRICE_ID_PRO=price_your-pro-price-id

# OpenAI / OpenRouter
OPENROUTER_API_KEY=your-openrouter-key

# Cloudflare
CLOUDFLARE_WORKER_URL=https://yt-intel.hex-tech-lab.workers.dev

# Sentry (Error Tracking)
NEXT_PUBLIC_SENTRY_AUTH_TOKEN=your-sentry-token

# Upstash Redis (Rate Limiting + Session Caching)
# Get from: https://console.upstash.io
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-api-token

# Environment
NODE_ENV=development
