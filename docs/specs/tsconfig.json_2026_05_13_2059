{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitAny": true,
    "baseUrl": ".",
    "paths": {
      "@types/*": ["./packages/types/src/*"],
      "@lib/*": ["./web/lib/*"],
      "@components/*": ["./web/components/*"],
      "@hooks/*": ["./web/hooks/*"],
      "@api/*": ["./web/app/api/*"]
    }
  },
  "exclude": ["node_modules"]
}
