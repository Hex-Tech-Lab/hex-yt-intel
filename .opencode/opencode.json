{
  "$schema": "https://opencode.ai/config.json",
  "model": "glm-preset/@preset/glm-53-flash-on-cheap",
  "small_model": "glm-preset/@preset/glm-53-flash-on-cheap",
  "provider": {
    "glm-preset": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter Preset (Morph)",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1"
      },
      "models": {
        "@preset/glm-53-flash-on-cheap": {
          "name": "GLM 5.3 Flash (user preset)",
          "options": {},
          "limit": {
            "context": 110000,
            "output": 16000
          }
        }
      }
    },
    "glm-mb": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter Direct (Modal\u2192BaseTen, no fallback)",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1"
      },
      "models": {
        "z-ai/glm-5.3-flash": {
          "name": "GLM 5.3 Flash (Modal\u2192BaseTen)",
          "options": {
            "reasoning_effort": "low",
            "provider": {
              "order": [
                "modal",
                "baseten"
              ],
              "only": [
                "modal",
                "baseten"
              ],
              "allow_fallbacks": false
            }
          },
          "limit": {
            "context": 110000,
            "output": 16000
          }
        }
      }
    }
  }
}
