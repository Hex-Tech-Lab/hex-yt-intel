{
  "$schema": "https://opencode.ai/config.json",
  "model": "jev-router/jev-auto",
  "small_model": "glm-preset/@preset/glm-53-flash-on-cheap",
  "provider": {
    "glm-preset": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter Preset (glm-53-flash-on-cheap, Modal-first)",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "headers": {
          "X-Title": "OC-hex-vIntel",
          "HTTP-Referer": "https://github.com/Hex-Tech-Lab/hex-yt-intel"
        }
      },
      "models": {
        "@preset/glm-53-flash-on-cheap": {
          "name": "GLM 5.3 Flash (user preset)",
          "options": {},
          "limit": {
            "context": 200000,
            "output": 16000
          }
        }
      }
    },
    "glm-dmb": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter Direct (Decart\u2192Modal\u2192BaseTen)",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1"
      },
      "models": {
        "z-ai/glm-5.3-flash": {
          "name": "GLM 5.3 Flash (Decart/Modal/BaseTen)",
          "options": {
            "reasoning_effort": "low",
            "provider": {
              "order": [
                "decart",
                "modal",
                "baseten"
              ],
              "allow_fallbacks": false
            }
          },
          "limit": {
            "context": 200000,
            "output": 16000
          }
        }
      }
    },
    "glm-cheap-preset": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter Preset (glm-53-flash-on-cheap) \u2014 hex-expan attribution",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "headers": {
          "X-Title": "OC-hex-expan",
          "HTTP-Referer": "https://github.com/Hex-Tech-Lab/hex-expan-press"
        }
      },
      "models": {
        "@preset/glm-53-flash-on-cheap": {
          "name": "GLM 5.3 Flash (cheap preset)",
          "limit": {
            "context": 200000,
            "output": 16000
          }
        }
      }
    },
    "glm-mb": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter Direct (Modal\u2192BaseTen, no fallback)",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "headers": {
          "X-Title": "OC-hex-vIntel",
          "HTTP-Referer": "https://github.com/Hex-Tech-Lab/hex-yt-intel"
        }
      },
      "models": {
        "z-ai/glm-5.3-flash": {
          "name": "GLM 5.3 Flash (Modal\u2192BaseTen)",
          "options": {
            "provider": {
              "order": [
                "modal",
                "baseten",
                "inference-net",
                "open-inference"
              ],
              "only": [
                "modal",
                "baseten",
                "inference-net",
                "open-inference"
              ],
              "allow_fallbacks": false
            },
            "reasoning": {
              "effort": "minimal",
              "enabled": true,
              "exclude": true
            }
          },
          "limit": {
            "context": 200000,
            "output": 16000
          }
        }
      }
    },
    "glm-mbio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter Direct (Modal\u2192BaseTen\u2192InferenceNet\u2192OpenInference, no fallback)",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "headers": {
          "X-Title": "OC-hex-expan",
          "HTTP-Referer": "https://github.com/Hex-Tech-Lab/hex-expan-press"
        }
      },
      "models": {
        "z-ai/glm-5.3-flash": {
          "name": "GLM 5.3 Flash (MBIO)",
          "options": {
            "reasoning": {
              "effort": "minimal",
              "enabled": true,
              "exclude": true
            },
            "cache_enabled": true,
            "cache_ttl_seconds": 10800,
            "provider": {
              "only": [],
              "sort": {
                "by": "latency",
                "partition": null
              },
              "order": [
                "modal",
                "baseten",
                "inference-net",
                "open-inference"
              ],
              "allow_fallbacks": false
            }
          },
          "limit": {
            "context": 200000,
            "output": 16000
          }
        }
      }
    },
    "glm-bmt": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter Direct (BaseTen\u2192Morph\u2192Together, no fallback)",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "headers": {
          "X-Title": "OC-hex-expan",
          "HTTP-Referer": "https://github.com/Hex-Tech-Lab/hex-expan-press"
        }
      },
      "models": {
        "z-ai/glm-5.3-flash": {
          "name": "GLM 5.3 Flash (BMT)",
          "options": {
            "reasoning": {
              "effort": "minimal",
              "enabled": true,
              "exclude": true
            },
            "cache_enabled": true,
            "cache_ttl_seconds": 10800,
            "provider": {
              "only": [],
              "sort": {
                "by": "latency",
                "partition": null
              },
              "order": [
                "baseten",
                "morph",
                "together"
              ],
              "allow_fallbacks": false
            }
          },
          "limit": {
            "context": 200000,
            "output": 16000
          }
        }
      }
    },
    "jev-router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "JEV router (OC-hex-vIntel)",
      "options": {
        "baseURL": "http://127.0.0.1:3040/v1",
        "apiKey": "jev-local",
        "headers": {
          "X-Title": "OC-hex-vIntel",
          "HTTP-Referer": "https://github.com/Hex-Tech-Lab"
        }
      },
      "models": {
        "jev-auto": {
          "name": "JEV auto (Haiku 5.5 <95k / GLM 5.3 Flash >=95k)",
          "limit": {
            "context": 200000,
            "output": 16000
          }
        }
      }
    },
    "jev-router-expan": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "JEV router (OC-hex-expan)",
      "options": {
        "baseURL": "http://127.0.0.1:3040/v1",
        "apiKey": "jev-local",
        "headers": {
          "X-Title": "OC-hex-expan",
          "HTTP-Referer": "https://github.com/Hex-Tech-Lab"
        }
      },
      "models": {
        "jev-auto": {
          "name": "JEV auto (Haiku 5.5 <95k / GLM 5.3 Flash >=95k)",
          "limit": {
            "context": 200000,
            "output": 16000
          }
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  }
}
